# Copy to server/.env and fill in

# Required
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
JWT_SECRET=replace-with-a-long-random-string

# Optional
PORT=5000
NODE_ENV=development
JWT_EXPIRE=30d
# Comma-separated origins allowed to call the API
CLIENT_ORIGIN=http://localhost:3000
# Set to true when running behind a reverse proxy (nginx, a load balancer)
TRUST_PROXY=false

# AI assistant
# Without a key the assistant reports "not configured" and the rest of the site is unaffected.
ANTHROPIC_API_KEY=
# anthropic (default) or mock: a rule-based stand-in that needs no key, for development and demos
ASSISTANT_PROVIDER=anthropic
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
ASSISTANT_DAILY_TURNS=40
ASSISTANT_DAILY_USER_BUDGET_USD=1
# Spending ceiling across all users per UTC day
ASSISTANT_DAILY_BUDGET_USD=20
# Concurrent answers per API instance
ASSISTANT_MAX_CONCURRENT_TURNS=8
# Development only, with ASSISTANT_PROVIDER=mock: rate_limit, overloaded, slow, refusal or tool_error
MOCK_FAILURE=
